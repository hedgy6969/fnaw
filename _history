X - 2, mapY - 2, 62, 62, 15)\n    hudLayer.image.drawRect(mapX - 2, mapY - 2, 62, 62, 1)\n    for (let b of wallMapLocations) {\n        wx = mapX + (b.col - mapMinCol) * 5\n        wy = mapY + (b.row - mapMinRow) * 5\n        if (wx >= mapX && wx <= mapX + 54 && wy >= mapY && wy <= mapY + 54) {\n            hudLayer.image.fillRect(wx, wy, 5, 5, 1)\n        }\n    }\n    for (let i = 0; i <= camLocations.length - 1; i++) {\n        loc4 = camLocations[i]\n        cx = mapX + (loc4.col - mapMinCol) * 5\n        cy = mapY + (loc4.row - mapMinRow) * 5\n        if (cx >= mapX && cx <= mapX + 54 && cy >= mapY && cy <= mapY + 54) {\n            hudLayer.image.fillRect(cx, cy, 5, 5, i == activeCamIndex ? 7 : 5)\n            hudLayer.image.drawRect(cx, cy, 5, 5, 15)\n        }\n    }\n    if (patrolTiles.length > 0 && Math.floor(game.runtime() / 300) % 2 == 0) {\n        animCol = Math.floor(mySprite.x / 16)\n        animRow = Math.floor(mySprite.y / 16)\n        ax = mapX + (animCol - mapMinCol) * 5 + 1\n        ay = mapY + (animRow - mapMinRow) * 5 + 1\n        if (ax >= mapX && ax <= mapX + 56 && ay >= mapY && ay <= mapY + 56) {\n            hudLayer.image.fillRect(ax, ay, 3, 3, 2)\n        }\n    }\n}\nfunction drawHudStatus () {\n    let light2On = 0\n    let light1On = 0\n    let door2Closed = 0\n    let door1Closed = 0\n    usage = 1\n    if (door1Closed) {\n        usage += 1\n    }\n    if (door2Closed) {\n        usage += 1\n    }\n    if (light1On) {\n        usage += 1\n    }\n    if (light2On) {\n        usage += 1\n    }\n    if (camsOpen) {\n        usage += 1\n    }\n    hudLayer.image.print(Math.ceil(powerPercent) + \"%\", 4, 102, 1)\nfor (let c = 0; c <= usage - 1; c++) {\n        let barColor = c < 2 ? 7 : (c < 4 ? 5 : 2)\nhudLayer.image.fillRect(4 + c * 5, 112, 4, 6, barColor)\n    }\n    hourLabel = \"\" + (gameHour == 0 ? 12 : gameHour) + \" AM\"\n    hudLayer.image.print(hourLabel, 128, 6, 1)\nif (!(powerOut)) {\n        hudLayer.image.fillRect(42, 11