ag.Invisible)) {\n        if (x >= panel.left && x <= panel.right) {\n            if (y >= panel.top && y < panel.y) {\n                // Top Button -> Door\n                if (isFirstPanel) {\n                    door1Closed = !(door1Closed)\n                    drawPanel(panel1, door1Closed, light1On)\n                    nightguard.sayText(door1Closed ? \"Door 1 CLOSED\" : \"Door 1 OPEN\", 800)\n                } else {\n                    door2Closed = !(door2Closed)\n                    drawPanel(panel2, door2Closed, light2On)\n                    nightguard.sayText(door2Closed ? \"Door 2 CLOSED\" : \"Door 2 OPEN\", 800)\n                }\n            } else if (y >= panel.y && y <= panel.bottom) {\n                // Bottom Button -> Light\n                if (isFirstPanel) {\n                    light1On = !(light1On)\n                    drawPanel(panel1, door1Closed, light1On)\n                    nightguard.sayText(light1On ? \"Light 1 ON\" : \"Light 1 OFF\", 800)\n                } else {\n                    light2On = !(light2On)\n                    drawPanel(panel2, door2Closed, light2On)\n                    nightguard.sayText(light2On ? \"Light 2 ON\" : \"Light 2 OFF\", 800)\n                }\n            }\n        }\n    }\n}\n// 6. Click Detection for Both Panels\nbrowserEvents.MouseLeft.onEvent(browserEvents.MouseButtonEvent.Pressed, function (x, y) {\n    checkPanelClick(panel1, x, y, true)\n    checkPanelClick(panel2, x, y, false)\n})\n// Helper to project any tile (col, row) onto the 2D screen\nfunction projectPanelToTile (panel: Sprite, col: number, row: number, offsetX: number) {\n    targetX = col * 16 + 8\n    targetY = row * 16 + 8\n    dx = targetX - nightguard.x\n    dy = targetY - nightguard.y\n"]]},{"start1":2546,"length1":548,"diffs":[[1,"    transformX = invDet * (dirY * dx - dirX * dy)\n    transformY = invDet * ((0 - planeY) * dx + planeX * dy)\n    if (transformY > 4) {\n        screenX = Math.floor(160 / 2 * (1 + transformX / transformY)) + offsetX\n        if (screenX >= -10 && screenX <= 170) {\n            panel.setFlag(SpriteFlag.Invisible, false)\n            panel.setPosition(screenX, 60)\n            return\n"]]},{"start1":2937,"length1":15,"diffs":[[1,""]]},{"start1":2943,"length1":2371,"diffs":[[1,"    panel.setFlag(SpriteFlag.Invisible, true)\n"]]},{"start1":2991,"length1":1400,"diffs":[[1,"let screenX = 0\nlet transformY = 0\nlet transformX = 0\n"]]},{"start1":3116,"length1":28,"diffs":[[1,"let dy = 0\nlet dx = 0\nlet targetY = 0\nlet targetX = 0\nlet img2: Image = null\nlet panel2: Sprite = null\nlet panel1: Sprite = null\n"]]},{"start1":3275,"length1":0,"diffs":[[1,"let light2On = false\nlet door2Closed = false\nlet light1On = false\n"]]},{"start1":3387,"length1":134,"diffs":[[1,""]]},{"start1":4684,"length1":299,"diffs":[[1,"// 5. Create Both Switch Panels (Panel 1 for 28,16 | Panel 2 for 28,20)\npanel1 = sprites.create(image.create(14, 26), SpriteKind.button)\npanel1.setFlag(SpriteFlag.RelativeToCamera, true)\npanel1.z = 10\npanel2 = sprites.create(image.create(14, 26), SpriteKind.button)\npanel2.setFlag(SpriteFlag.RelativeToCamera, true)\npanel2.z = 10\ndrawPanel(panel1, door1Closed, light1On)\ndrawPanel(panel2, door2Closed, light2On)\n// 7. Update Both Projected Panels & Camera Turning Every Frame\n"]]},{"start1":5424,"length1":389,"diffs":[[1,"    // Project Panel 1 onto tile (28, 16) with +12px right offset\n    projectPanelToTile(panel1, 28, 16, 24)\n    // Project Panel 2 onto tile (28, 20) with -12px left offset (flip to +12 if needed!)\n    projectPanelToTile(panel2, 28, 20, 24)\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":642,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]}]},{"timestamp":1795565109336,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":3573,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable type=\"KIND_Spri