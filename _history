ol - targetDoorCol) + Math.abs(p.row - targetDoorRow)\n                if (distToDoor < bestNextDist) {\n                    bestNextDist = distToDoor\n                    bestNextTile = p\n                }\n            }\n        }\n        if (bestNextTile == null && currentDist <= 4) {\n            bestNextTile = tiles.getTileLocation(targetDoorCol, targetDoorRow)\n            music.play(music.createSoundEffect(WaveShape.Noise, 200, 80, 255, 0, 120, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.InBackground)\n        }\n        if (bestNextTile != null) {\n            if (camsOpen && camLocations.length > 0) {\n                let activeCamTile = camLocations.get(activeCamIndex)\nif (bestNextTile.col == activeCamTile.col && bestNextTile.row == activeCamTile.row) {\n                    return\n                }\n            }\n            tiles.placeOnTile(mySprite, bestNextTile)\n        }\n    }\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":690,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]},{"type":"edited","filename":"tilemap.g.jres","patch":[{"start1":2026,"length1":21796,"diffs":[[1,"        \"data\": \"\",\n"]]}]},{"type":"edited","filename":"tilemap.g.ts","patch":[{"start1":814,"length1":10953,"diffs":[[1,"            case \"level1\":return tiles.createTilemap(hex``, img`\n"]]}]}]},{"timestamp":1795577660263,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":523656,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable type=\"KIND_SpriteKind\" id=\"qn]Ah,WLiJ?i!LuC|vt@\">button</variable><variable type=\"KIND_SpriteKind\" id=\"e!hm:W.p|EV3pPPRg/4b\">Player</variable><variable type=\"KIND_SpriteKind\" id=\"9+qNA1OWe}TgDH_-Y+-l\">Projectile</variable><variable type=\"KIND_SpriteKind\" id=\"6b1{%E+!!$U+rd|PRXtQ\">Food</variable><variable type=\"KIND_SpriteKind\" id=\"K,J3l!:|w8O).Co1}R9~\"