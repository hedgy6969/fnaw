lock type=\"variables_get\" disabled-reasons=\"pxt_automatic_disabled\" x=\"7858\" y=\"4643\"><field name=\"VAR\" id=\".R1y(EEyu0lcW9ci2x(I\">myDoorOpenAnimation</field></block><block type=\"variables_get\" disabled-reasons=\"pxt_automatic_disabled\" x=\"8129\" y=\"4643\"><field name=\"VAR\" id=\".R1y(EEyu0lcW9ci2x(I\">myDoorOpenAnimation</field></block><block type=\"variables_get\" disabled-reasons=\"pxt_automatic_disabled\" x=\"8400\" y=\"4643\"><field name=\"VAR\" id=\"3EF8]Sy`6CGgFKNSXLgo\">door1Closed</field></block></xml>","main.ts":"namespace SpriteKind {\n    export const button = SpriteKind.create()\n}\nfunction drawCameraOverlay () {\n    hudLayer.image.drawRect(2, 2, 156, 108, 1)\n    if (Math.floor(game.runtime() / 500) % 2 == 0) {\n        hudLayer.image.fillRect(8, 8, 5, 5, 2)\n    }\n    hudLayer.image.print(\"CAM \" + (activeCamIndex + 1), 16, 7, 1)\nmapX = 94\n    mapY = 46\n    hudLayer.image.fillRect(mapX - 2, mapY - 2, 62, 62, 15)\n    hudLayer.image.drawRect(mapX - 2, mapY - 2, 62, 62, 1)\n    for (let b of wallMapLocations) {\n        wx = mapX + (b.col - mapMinCol) * 5\n        wy = mapY + (b.row - mapMinRow) * 5\n        if (wx >= mapX && wx <= mapX + 54 && wy >= mapY && wy <= mapY + 54) {\n            hudLayer.image.fillRect(wx, wy, 5, 5, 1)\n        }\n    }\n    for (let i = 0; i <= camLocations.length - 1; i++) {\n        let loc4 = camLocations.get(i)\ncx = mapX + (loc4.col - mapMinCol) * 5\n        cy = mapY + (loc4.row - mapMinRow) * 5\n        if (cx >= mapX && cx <= mapX + 54 && cy >= mapY && cy <= mapY + 54) {\n            hudLayer.image.fillRect(cx, cy, 5, 5, i == activeCamIndex ? 7 : 5)\n            hudLayer.image.drawRect(cx, cy, 5, 5, 15)\n        }\n    }\n    if (patrolTiles.length > 0 && Math.floor(game.runtime() / 300) % 2 == 0) {\n        animCol = Math.floor(mySprite.x / 16)\n        animRow = Math.floor(mySprite.y / 16)\n        ax = mapX + (animCol - mapMinCol) * 5 + 1\n        ay = mapY + (animRow - mapMinRow) * 5 + 1\n        if (ax >= mapX && ax <= mapX + 56 && ay >= mapY && ay <= mapY + 56) {\n            hudLayer.image.fillRect(ax, ay, 3, 3, 2)\n        }\n    }\n}\nfunction drawHudStatus () {\n    usage = 1\n    if (door1Closed) {\n        usage += 1\n    }\n    if (door2Closed) {\n        usage += 1\n    }\n    if (light1On) {\n        usage += 1\n    }\n    if (light2On) {\n        usage += 1\n    }\n    if (camsOpen) {\n        usage += 1\n    }\n    hudLayer.image.print(Math.ceil(powerPercent) + \"%\", 4, 102, 1)\nfor (let c = 0; c <= usage - 1; c++) {\n        let barColor = c < 2 ? 7 : (c < 4 ? 5 : 2)\nhudLayer.image.fillRect(4 + c * 5, 112, 4, 6, barColor)\n    }\n    hourLabel = \"\" + (gameHour == 0 ? 12 : gameHour) + \" AM\"\n    hudLayer.image.print(hourLabel, 128, 6, 1)\nif (!(powerOut)) {\n        hudLayer.image.fillRect(42, 112, 76, 8, 12)\n        hudLayer.image.drawRect(42, 112, 76, 8, 1)\n        hudLayer.image.drawLine(76, 116, 80, camsOpen ? 118 : 114, 1)\n        hudLayer.image.drawLine(80, camsOpen ? 118 : 114, 84, 116, 1)\n    }\n}\n// Helper: Draw warm hallway light beam across an open doorway when its Light button is ON\nfunction drawDoorwayLight (x1: number, y1: number, x2: number, y2: number, isLightOn: boolean) {\n    if (!(isLightOn)) {\n        return\n    }\n    dirX = Render.getAttribute(Render.attribute.dirX)\n    dirY = Render.getAttribute(Render.attribute.dirY)\n    planeX = (0 - dirY) * 0.66\n    planeY = dirX * 0.66\n    invDet = 1 / (planeX * dirY - dirX * planeY)\n    dxA = x1 - nightguard.x\n    dyA = y1 - nightguard.y\n    txA = invDet * (dirY * dxA - dirX * dyA)\n    depthA = invDet * ((0 - planeY) * dxA + planeX * dyA)\n    dxB = x2 - nightguard.x\n    dyB = y2 - nightguard.y\n    txB = invDet * (dirY * dxB - dirX * dyB)\n    depthB = invDet * ((0 - planeY) * dxB + planeX * dyB)\n    if (depthA <= 4 || depthB <= 4) {\n        return\n    }\n    sxA = Math.floor(80 * (1 + txA / depthA))\n    sxB = Math.floor(80 * (1 + txB / depthB))\n    let leftX = sxA < sxB ? sxA : sxB\nlet rightX = sxA < sxB ? sxB : sxA\nlet leftDepth = sxA < sxB ? depthA : depthB\nlet rightDepth = sxA < sxB ? depthB : depthA\nwidth = rightX - leftX\n    if (rightX < 0 || leftX > 160 || width < 1) {\n        return\n    }\n    hLeft = Math.floor(16 * 120 / leftDepth)\n    hRight = Math.floor(16 * 120 / rightDepth)\n    for (let col = 0; col <= width; col += 2) {\n        let t = col / width\n        let sx = leftX + col\n        if (sx < 0 || sx >= 160) continue\n\n        let fullWallH = hLeft + (hRight - hLeft) * t\n        let wallTop = Math.floor(60 - fullWallH * 0.5)\n        let wallBot = Math.floor(60 + fullWallH * 0.5)\n        hudLayer.image.drawLine(sx, wallTop, sx, wallBot, 5)\n    }\n}\n// Helper: Draw perspective-slanted switch panels\nfunction drawWallPanel (x1: number, y1: number, x2: number, y2: number, isDoorClosed: boolean, isLightOn: boolean, isPanel1: boolean) {\n    dirX22 = Render.getAttribute(Render.attribute.dirX)\n    dirY22 = Render.getAttribute(Render.attribute.dirY)\n    planeX22 = (0 - dirY22) * 0.66\n    planeY22 = dirX22 * 0.66\n    invDet22 = 1 / (planeX22 * dirY22 - dirX22 * planeY22)\n    dxA22 = x1 - nightguard.x\n    dyA22 = y1 - nightguard.y\n    txA22 = invDet22 * (dirY22 * dxA22 - dirX22 * dyA22)\n    depthA22 = invDet22 * ((0 - planeY22) * dxA22 + planeX22 * dyA22)\n    dxB22 = x2 - nightguard.x\n    dyB22 = y2 - nightguard.y\n    txB22 = invDet22 * (dirY22 * dxB22 - dirX22 * dyB22)\n    depthB22 = invDet22 * ((0 - planeY22) * dxB22 + planeX22 * dyB22)\n    if (depthA22 <= 4 || depthB22 <= 4) {\n        if (isPanel1) {\n            p1Visible = false\n        } else {\n            p2Visible = false\n        }\n        return\n    }\n    sxA22 = Math.floor(80 * (1 + txA22 / depthA22))\n    sxB22 = Math.floor(80 * (1 + txB22 / depthB22))\n    let leftX22 = sxA22 < sxB22 ? sxA22 : sxB22\nlet rightX22 = sxA22 < sxB22 ? sxB22 : sxA22\nlet leftDepth22 = sxA22 < sxB22 ? depthA22 : depthB22\nlet rightDepth22 = sxA22 < sxB22 ? depthB22 : depthA22\nwidth22 = rightX22 - leftX22\n    if (rightX22 < 0 || leftX22 > 160 || width22 < 2) {\n        if (isPanel1) {\n            p1Visible = false\n        } else {\n            p2Visible = false\n        }\n        return\n    }\n    img2 = hudLayer.image\n    hLeft22 = Math.floor(16 * 120 / leftDepth22)\n    hRight22 = Math.floor(16 * 120 / rightDepth22)\n    topMax = 60 - Math.floor(Math.max(hLeft22, hRight22) * 0.16)\n    botMax = 60 + Math.floor(Math.max(hLeft22, hRight22) * 0.16)\n    if (isPanel1) {\n        p1Visible = true\n        p1Left = leftX22\n        p1Right = rightX22\n        p1Top = topMax\n        p1Bottom = botMax\n    } else {\n        p2Visible = true\n        p2Left = leftX22\n        p2Right = rightX22\n        p2Top = topMax\n        p2Bottom = botMax\n    }\n    for (let col22 = 0; col22 <= width22; col22++) {\n        v = col22 / width22\n        sx22 = leftX22 + col22\n        if (sx22 < 0 || sx22 >= 160) {\n            continue;\n        }\n        h = hLeft22 + (hRight22 - hLeft22) * v\n        boxTop = Math.floor(60 - h * 0.16)\n        boxBot = Math.floor(60 + h * 0.16)\n        boxH = boxBot - boxTop\n        img2.drawLine(sx22, boxTop, sx22, boxBot, (col22 == 0 || col22 == width22) ? 15 : 12)\n        img2.setPixel(sx22, boxTop, 15)\n        img2.setPixel(sx22, boxBot, 15)\n        margin = Math.max(1, Math.floor(width22 * 0.2))\n        if (col22 >= margin && col22 <= width22 - margin) {\n            dTop = boxTop + Math.floor(boxH * 0.12)\n            dBot = boxTop + Math.floor(boxH * 0.44)\n            if (dBot > dTop) {\n                img2.drawLine(sx22, dTop, sx22, dBot, isDoorClosed ? 7 : 2)\n            }\n            lTop = boxTop + Math.floor(boxH * 0.56)\n            lBot = boxTop + Math.floor(boxH * 0.88)\n            if (lBot > lTop) {\n                img2.drawLine(sx22, lTop, sx22, lBot, isLightOn ? 5 : 1)\n            }\n        }\n    }\n}\nfunction switchToCamera (index: number) {\n    if (index < 0 || index >= camLocations.length) {\n        return\n    }\n    activeCamIndex = index\n    let targetLoc = camLocations.get(index)\ntiles.placeOnTile(nightguard, targetLoc)\n    if (!(tiles.tileAtLocationIsWall(tiles.getTileLocation(targetLoc.col + 1, targetLoc.row)))) {\n        Render.setViewAngleInDegree(0)\n    } else if (!(tiles.tileAtLocationIsWall(tiles.getTileLocation(targetLoc.col, targetLoc.row + 1)))) {\n        Render.setViewAngleInDegree(90)\n    } else if (!(tiles.tileAtLocationIsWall(tiles.getTileLocation(targetLoc.col - 1, targetLoc.row)))) {\n        Render.setViewAngleInDegree(180)\n    } else {\n        Render.setViewAngleInDegree(270)\n    }\n}\n// 7. Click Detection Using Projected 3D Hitboxes & Camera HUD\nbrowserEvents.MouseLeft.onEvent(browserEvents.MouseButtonEvent.Pressed, function (x, y) {\n    if (powerOut) {\n        return\n    }\n    if (x >= 42 && x <= 118 && y >= 110) {\n        toggleCams()\n        return\n    }\n    if (camsOpen) {\n        mapX2 = 94\n        mapY2 = 46\n        for (let j = 0; j <= camLocations.length - 1; j++) {\n            let loc5 = camLocations.get(j)\ncx2 = mapX2 + (loc5.col - mapMinCol) * 5\n            cy2 = mapY2 + (loc5.row - mapMinRow) * 5\n            if (x >= cx2 - 2 && x <= cx2 + 7 && y >= cy2 - 2 && y <= cy2 + 7) {\n                switchToCamera(j)\n                return\n            }\n        }\n        return\n    }\n    if (p1Visible && x >= p1Left && x <= p1Right && y >= p1Top && y <= p1Bottom) {\n        if (y < 60) {\n            door1Closed = !(door1Closed)\n            tiles.setWallAt(tiles.getTileLocation(29, 15), door1Closed)\n        } else {\n            light1On = !(light1On)\n            if (light1On) {\n                light2On = false\n            }\n        }\n    }\n    if (p2Visible && x >= p2Left && x <= p2Right && y >= p2Top && y <= p2Bottom) {\n        if (y < 60) {\n            door2Closed = !(door2Closed)\n            tiles.setWallAt(tiles.getTileLocation(29, 19), door2Closed)\n        } else {\n            light2On = !(light2On)\n            if (light2On) {\n                light1On = false\n            }\n        }\n    }\n})\n// Helper: Draw a perspective-slanted sliding FNAF metal door across a doorway\nfunction drawPerspectiveDoor (x1: number, y1: number, x2: number, y2: number, progress: number) {\n    if (progress <= 0.02) {\n        return\n    }\n    dirX2 = Render.getAttribute(Render.attribute.dirX)\n    dirY2 = Render.getAttribute(Render.attribute.dirY)\n    planeX2 = (0 - dirY2) * 0.66\n    planeY2 = dirX2 * 0.66\n    invDet2 = 1 / (planeX2 * dirY2 - dirX2 * planeY2)\n    dxA2 = x1 - nightguard.x\n    dyA2 = y1 - nightguard.y\n    txA2 = invDet2 * (dirY2 * dxA2 - dirX2 * dyA2)\n    depthA2 = invDet2 * ((0 - planeY2) * dxA2 + planeX2 * dyA2)\n    dxB2 = x2 - nightguard.x\n    dyB2 = y2 - nightguard.y\n    txB2 = invDet2 * (dirY2 * dxB2 - dirX2 * dyB2)\n    depthB2 = invDet2 * ((0 - planeY2) * dxB2 + planeX2 * dyB2)\n    if (depthA2 <= 4 || depthB2 <= 4) {\n        return\n    }\n    sxA2 = Math.floor(80 * (1 + txA2 / depthA2))\n    sxB2 = Math.floor(80 * (1 + txB2 / depthB2))\n    let leftX2 = sxA2 < sxB2 ? sxA2 : sxB2\nlet rightX2 = sxA2 < sxB2 ? sxB2 : sxA2\nlet leftDepth2 = sxA2 < sxB2 ? depthA2 : depthB2\nlet rightDepth2 = sxA2 < sxB2 ? depthB2 : depthA2\nwidth2 = rightX2 - leftX2\n    if (rightX2 < 0 || leftX2 > 160 || width2 < 1) {\n        return\n    }\n    img3 = hudLayer.image\n    hLeft2 = Math.floor(16 * 120 / leftDepth2)\n    hRight2 = Math.floor(16 * 120 / rightDepth2)\n    for (let col2 = 0; col2 <= width2; col2++) {\n        u = col2 / width2\n        sx2 = leftX2 + col2\n        if (sx2 < 0 || sx2 >= 160) {\n            continue;\n        }\n        fullWallH2 = hLeft2 + (hRight2 - hLeft2) * u\n        wallTop2 = Math.floor(60 - fullWallH2 * 0.5)\n        doorBot = Math.floor(wallTop2 + fullWallH2 * progress)\n        curH = doorBot - wallTop2\n        if (curH <= 0) {\n            continue;\n        }\n        // Door frame edges + ribbed silver metal body\n        isEdge = col2 == 0 || col2 == width2\n        isRib = col2 % 4 == 0\n        let metalColor = isEdge ? 15 : (isRib ? 11 : 13)\nimg3.drawLine(sx2, wallTop2, sx2, doorBot, metalColor)\n        // Horizontal metal crossbars\n        if (!(isEdge) && curH > 8) {\n            img3.setPixel(sx2, wallTop2 + Math.floor(curH * 0.33), 11)\n            img3.setPixel(sx2, wallTop2 + Math.floor(curH * 0.66), 11)\n        }\n        // Yellow & black hazard stripe along the bottom edge\n        stripeH = Math.max(2, Math.floor(fullWallH2 * 0.1))\n        stripeTop = Math.max(wallTop2, doorBot - stripeH)\n        let stripeColor = (Math.floor(col2 / 3) % 2 == 0) ? 5 : 15\nimg3.drawLine(sx2, stripeTop, sx2, doorBot, stripeColor)\n    }\n}\nfunction toggleCams () {\n    if (powerOut) {\n        return\n    }\n    camsOpen = !(camsOpen)\n    if (camsOpen) {\n        savedOfficeAngle = cameraAngle\n        switchToCamera(activeCamIndex)\n    } else {\n        tiles.placeOnRandomTile(nightguard, sprites.castle.tileGrass2)\n        cameraAngle = savedOfficeAngle\n        Render.setViewAngleInDegree(cameraAngle)\n    }\n}\nfunction addWallNeighbor (col: number, row: number) {\n    if (col < 0 || row < 0) {\n        return\n    }\n    loc = tiles.getTileLocation(col, row)\n    if (tiles.tileAtLocationIsWall(loc)) {\n        for (let w of wallMapLocations) {\n            if (w.col == col && w.row == row) {\n                return\n            }\n        }\n        wallMapLocations.push(loc)\n    }\n}\nlet nextIndex = 0\nlet drain = 0\nlet animRow2 = 0\nlet animCol2 = 0\nlet door2Progress = 0\nlet door1Progress = 0\nlet loc: tiles.Location = null\nlet stripeTop = 0\nlet stripeH = 0\nlet isRib = false\nlet isEdge = false\nlet curH = 0\nlet doorBot = 0\nlet wallTop2 = 0\nlet fullWallH2 = 0\nlet sx2 = 0\nlet u = 0\nlet hRight2 = 0\nlet hLeft2 = 0\nlet img3: Image = null\nlet width2 = 0\nlet sxB2 =